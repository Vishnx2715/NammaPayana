  "dialogues": [
    {
      "id": "dialogue_darshini",
      "title": "Breakfast at an Udupi Darshini",
      "scenario": "food",
      "steps": [
        {
          "speaker": "Traveller",
          "kannada": "ನಮಸ್ಕಾರ, ಉಪಹಾರಕ್ಕೆ ಏನು ಸಿಗುತ್ತೆ?",
          "transliteration": "Namaskara, upahaarakke enu sigutte?",
          "english": "Hello, what is available for breakfast?"
        },
        {
          "speaker": "Server",
          "kannada": "ನಮಸ್ಕಾರ ಸ್ವಾಮಿ! ಬಿಸಿ ತಟ್ಟೆ ಇಡ್ಲಿ, ಮಸಾಲೆ ದೋಸೆ, ಖಾರಾಬಾತ್ ಇದೆ.",
          "transliteration": "Namaskara swami! Bisi tatte idli, masale dose, kharabath ide.",
          "english": "Welcome sir! We have hot plate idli, masala dosa, and kharabath."
        },
        {
          "speaker": "Traveller",
          "kannada": "ಒಂದು ತಟ್ಟೆ ಇಡ್ಲಿ ವಡೆ ಮತ್ತು ಫಿಲ್ಟರ್ ಕಾಫಿ ಕೊಡಿ.",
          "transliteration": "Ondu tatte idli vade mattu filter coffee kodi.",
          "english": "Please give one plate idli-vada and a filter coffee."
        },
        {
          "speaker": "Server",
          "kannada": "ಆಯಿತು, ಐದು ನಿಮಿಷದಲ್ಲಿ ತರುತ್ತೇನೆ.",
          "transliteration": "Aayitu, aidu nimishadalli taruttene.",
          "english": "Right away, bringing it in five minutes."
        }
      ]
    },
    {
      "id": "dialogue_auto",
      "title": "Hailing an Auto to Mysuru Palace",
      "scenario": "transport",
      "steps": [
        {
          "speaker": "Traveller",
          "kannada": "ಅರಮನೆಗೆ ಹೋಗಲು ಆಟೋ ಬರುತ್ತಾ?",
          "transliteration": "Aramanega hogalu auto baruttaa?",
          "english": "Will the auto go to the Palace?"
        },
        {
          "speaker": "Driver",
          "kannada": "ಹೌದು ಬನ್ನಿ, ಮೀಟರ್ ಮೇಲೆ ಇಪ್ಪತ್ತು ರೂಪಾಯಿ ಆಗುತ್ತೆ.",
          "transliteration": "Haudu banni, meter mele ippattu roopayi aagutte.",
          "english": "Yes please hop in, it will be twenty rupees above the meter."
        },
        {
          "speaker": "Traveller",
          "kannada": "ಸರಿ, ಮೀಟರ್ ಹಾಕಿ ಹೋಗೋಣ.",
          "transliteration": "Sari, meter haaki hogona.",
          "english": "All right, please put the meter on and let's go."
        }
      ]
    },
    {
      "id": "dialogue_market",
      "title": "Buying Channapatna Wooden Toys or Coffee",
      "scenario": "shopping",
      "steps": [
        {
          "speaker": "Traveller",
          "kannada": "ಈ ಕಾಫಿ ಪುಡಿ ಎಷ್ಟು ಬೆಲೆ?",
          "transliteration": "Ee coffee pudi eshtu bele?",
          "english": "What is the price of this coffee powder?"
        },
        {
          "speaker": "Shopkeeper",
          "kannada": "ಅರ್ಧ ಕಿಲೋಗೆ ಇನ್ನೂರು ರೂಪಾಯಿ ಸ್ವಾಮಿ.",
          "transliteration": "Ardha kiloge innooru roopayi swami.",
          "english": "Two hundred rupees for half a kilogram, sir."
        },
        {
          "speaker": "Traveller",
          "kannada": "ಸರಿ, ಒಂದು ಕಿಲೋ ಪ್ಯಾಕ್ ಮಾಡಿ ಕೊಡಿ. ಯುಪಿಐ ಇದೆಯಾ?",
          "transliteration": "Sari, ondu kilo pack maadi kodi. UPI ideya?",
          "english": "Okay, please pack one kilogram. Do you take UPI?"
        },
        {
          "speaker": "Shopkeeper",
          "kannada": "ಖಂಡಿತ, ಈ ಕ್ಯೂಆರ್ ಕೋಡ್ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ.",
          "transliteration": "Khandita, ee QR code scan maadi.",
          "english": "Certainly, please scan this QR code."
        }
      ]
    },
    {
      "id": "dialogue_directions",
      "title": "Asking for Temple Route",
      "scenario": "directions",
      "steps": [
        {
          "speaker": "Traveller",
          "kannada": "ಕ್ಷಮಿಸಿ, ವಿರೂಪಾಕ್ಷ ದೇವಾಲಯಕ್ಕೆ ಹೇಗೆ ಹೋಗಬೇಕು?",
          "transliteration": "Kshamisi, Virupaksha devalayakke hege hogabeku?",
          "english": "Excuse me, how do I reach Virupaksha temple?"
        },
        {
