# Namma Payana - Environment Configuration Template
# Copy this to .env and fill in your values.
# NEVER commit .env to git. See SECURITY_NOTES.md for key rotation instructions.

FLASK_ENV=development
PORT=5000
SECRET_KEY=generate-a-strong-random-secret-here

DATABASE_PATH=instance/nammapayana.db

# ─── AI Provider Configuration ────────────────────────────────────────────────
# Get a FREE Gemini API key at: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Supabase Configuration ───────────────────────────────────────────────────
# Find these in your Supabase project: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ─── Authentication ───────────────────────────────────────────────────────────
# Required for Phase 0B JWT verification of Supabase tokens
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ─── CORS Configuration ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ─── Production WSGI ──────────────────────────────────────────────────────────
WEB_CONCURRENCY=2
LOG_LEVEL=info

# Optional: self-hosted OSRM routing server for real road distances
# Leave blank to use offline haversine estimation (default)
OSRM_BASE_URL=https://router.project-osrm.org
